<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_title_1">
        <ListPreference
            android:key="resolution"
            android:title="@string/pref_title_2"
            android:summary="@string/pref_summary_3"
            android:defaultValue="800x480"
            android:entries="@array/resolution_labels"
            android:entryValues="@array/resolution_values" />
        <ListPreference
            android:key="fps"
            android:title="@string/pref_title_4"
            android:defaultValue="30"
            android:entries="@array/fps_labels"
            android:entryValues="@array/fps_values" />
        <ListPreference
            android:key="video_decoder"
            android:title="@string/pref_title_5"
            android:summary="@string/pref_summary_6"
            android:defaultValue="auto"
            android:entries="@array/video_decoder_labels"
            android:entryValues="@array/video_decoder_values" />
        <CheckBoxPreference
            android:key="adaptive_video"
            android:title="@string/pref_title_7"
            android:summary="@string/pref_summary_8"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="night_mode"
            android:title="@string/pref_title_9"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_10">
        <CheckBoxPreference
            android:key="media_keys"
            android:title="@string/pref_title_11"
            android:summary="@string/pref_summary_12"
            android:defaultValue="true" />
        <ListPreference
            android:key="honda_sw_address"
            android:dependency="media_keys"
            android:title="@string/pref_title_13"
            android:summary="@string/pref_summary_14"
            android:defaultValue="260"
            android:entries="@array/honda_sw_address_labels"
            android:entryValues="@array/honda_sw_address_values" />
        <CheckBoxPreference
            android:key="calls_car_bt"
            android:title="@string/pref_title_15"
            android:summary="@string/pref_summary_16"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="return_after_call"
            android:title="@string/pref_title_17"
            android:summary="@string/pref_summary_18"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="audio_usb"
            android:title="@string/pref_title_19"
            android:summary="@string/pref_summary_20"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="car_mic"
            android:title="@string/pref_title_21"
            android:summary="@string/pref_summary_22"
            android:defaultValue="true" />
        <Preference
            android:title="@string/pref_title_23"
            android:summary="@string/pref_summary_24">
            <intent
                android:targetPackage="com.fk2play"
                android:targetClass="com.fk2play.MicTestActivity" />
        </Preference>
        <ListPreference
            android:key="mic_source"
            android:title="@string/pref_title_25"
            android:summary="@string/pref_summary_26"
            android:defaultValue="auto"
            android:entries="@array/mic_source_labels"
            android:entryValues="@array/mic_source_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_27">
        <ListPreference
            android:key="display_thread"
            android:title="@string/pref_title_28"
            android:summary="@string/pref_summary_29"
            android:defaultValue="auto"
            android:entries="@array/display_thread_labels"
            android:entryValues="@array/display_thread_values" />
        <ListPreference
            android:key="video_format"
            android:title="@string/pref_title_30"
            android:summary="@string/pref_summary_31"
            android:defaultValue="0"
            android:entries="@array/video_format_labels"
            android:entryValues="@array/video_format_values" />
        <CheckBoxPreference
            android:key="show_keycodes"
            android:title="@string/pref_title_32"
            android:summary="@string/pref_summary_33"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="volume_invert"
            android:title="@string/pref_title_34"
            android:summary="@string/pref_summary_35"
            android:defaultValue="false" />
        <ListPreference
            android:key="sw_reg_mode"
            android:title="@string/pref_title_36"
            android:summary="@string/pref_summary_37"
            android:defaultValue="C"
            android:entries="@array/sw_reg_mode_labels"
            android:entryValues="@array/sw_reg_mode_values" />
        <ListPreference
            android:key="volume_window"
            android:title="@string/pref_title_38"
            android:summary="@string/pref_summary_39"
            android:defaultValue="3"
            android:entries="@array/volume_window_labels"
            android:entryValues="@array/volume_window_values" />
        <CheckBoxPreference
            android:key="track_invert"
            android:title="@string/pref_title_40"
            android:summary="@string/pref_summary_41"
            android:defaultValue="false" />
        <ListPreference
            android:key="volume_mode"
            android:title="@string/pref_title_42"
            android:summary="@string/pref_summary_43"
            android:defaultValue="honda"
            android:entries="@array/volume_mode_labels"
            android:entryValues="@array/volume_mode_values" />
        <Preference
            android:key="video_decoder_status"
            android:title="@string/pref_title_44"
            android:summary="@string/pref_summary_45" />
        <Preference
            android:key="honda_sw_status"
            android:title="@string/pref_title_46"
            android:summary="@string/pref_summary_47" />
        <Preference
            android:key="key_log"
            android:title="@string/pref_title_48"
            android:summary="@string/pref_summary_49" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_title_50">
        <CheckBoxPreference
            android:key="wifi_5g"
            android:title="@string/pref_title_51"
            android:summary="@string/pref_summary_52"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="right_hand_drive"
            android:title="@string/pref_title_53"
            android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
